{
  "name": "my-first-extension",
  "displayName": "My-first-extension",
  "description": "",
  "publisher": "alexZzz",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonathan240105/vscode-snippets-extension.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snippets-sidebar",
          "title": "Mis Snippets",
          "icon": "$(bookmark)"
        }
      ]
    },
    "views": {
      "snippets-sidebar": [
        {
          "icon": "$(file-code)",
          "id": "mySnippetsExplorer",
          "name": "Librería de Snippets"
        }
      ]
    },
    "commands": [
      {
        "command": "my-first-extension.quickSave",
        "title": "Guardado rápido"
      },
      {
        "command": "my-first-extension.detailedSave",
        "title": "Guardado detallado"
      },
      {
        "command": "my-first-extension.deleteSnippet",
        "title": "Eliminar snippet",
        "icon": "$(trash)"
      },
      {
        "command": "my-first-extension.copySnippet",
        "title": "Copiar snippet",
        "icon": "$(copy)"
      },
      {
        "command": "my-first-extension.editSnippet",
        "title": "Editar snippet",
        "icon": "$(edit)"
      },
      {
        "command": "my-first-extension.searchSnippets",
        "title": "Buscar e insertar Snippet",
        "category": "SmartSnippets"
      },
      {
        "command": "my-first-extension.exportSnippets",
        "title": "Exportar Snippets",
        "category": "Smart Snippets",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "my-first-extension.importSnippets",
        "title": "Importar Snippets",
        "category": "Smart Snippets",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "my-first-extension.deleteSnippet",
          "when": "view == mySnippetsExplorer && viewItem == snippet",
          "group": "inline"
        },
        {
          "command": "my-first-extension.copySnippet",
          "when": "view == mySnippetsExplorer && viewItem == snippet",
          "group": "inline"
        },
        {
          "command": "my-first-extension.editSnippet",
          "when": "view == mySnippetsExplorer && viewItem == snippet",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "my-first-extension.exportSnippets",
          "when": "view == mySnippetsExplorer",
          "group": "navigation@1"
        },
        {
          "command": "my-first-extension.importSnippets",
          "when": "view == mySnippetsExplorer",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
